# Copy to .env and fill in. Never commit .env.

# Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=

# SQLite for development. For PostgreSQL later, e.g.:
# DATABASE_URL=postgresql+psycopg2://user:password@localhost:5432/portfolio
DATABASE_URL=sqlite:///./portfolio.db

# Comma-separated list of frontend origins allowed to call the API
ALLOWED_ORIGINS=http://localhost:5173

ACCESS_TOKEN_EXPIRE_MINUTES=480
UPLOAD_DIR=uploads
MAX_UPLOAD_MB=5
ENABLE_DOCS=true

# Optional: email yourself when someone uses the contact form
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
CONTACT_NOTIFY_TO=
